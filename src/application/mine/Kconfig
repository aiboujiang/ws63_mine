#===============================================================================
# @brief    Kconfig file for custom mine demos.
#===============================================================================

choice
    prompt "Mine SLE UART Demo Role"
    optional

config MINE_SUPPORT_SLE_UART_HOST_DEMO
    bool "Support Mine SLE UART Host Demo."
    help
        Build host side demo (SLE server + UART0 bridge).

config MINE_SUPPORT_SLE_UART_SLAVE_DEMO
    bool "Support Mine SLE UART Slave Demo."
    help
        Build slave side demo (SLE client + UART0 bridge).

endchoice

config MINE_SUPPORT_UART2_EXT_WK2114
    bool "Support Mine UART2 Expand via WK2114."
    default n
    help
        Build the Mine WK2114 UART2 extension skeleton module.
        This module provides a software framework for extending one UART2
        host port into four sub UART channels via WK2114.

config MINE_SUPPORT_WS63_FINAL_LAYERED
    bool "Support Mine WS63 final layered framework (WS63 master)."
    default y
    help
        Build the final layered framework under application/mine/ws63_final.
        In this framework, WS63 is the main controller and WK2114 is treated
        as an external expansion chip in Driver layer.

config MINE_SUPPORT_RGB_LED_DEMO
    bool "Support Mine RGB LED Demo (GPIO4 DI)."
    default n
    help
        Build single RGB LED demo under application/mine/rgb_led.
        DI is fixed to GPIO4 for WS2812B-compatible one-wire timing.
